NODE_ENV=production
APP_URL=https://example.com
API_URL=https://example.com/api
DOMAIN_NAME=example.com
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=dropshipping_intel
DATABASE_URL=postgresql://app:replace-with-strong-password@postgres:5432/dropshipping_intel?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=replace-with-long-random-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
SERPAPI_API_KEY=
CRAWL_MAX_PAGES=4
CRAWL_TIMEOUT_MS=12000
BACKEND_IMAGE=dropship-intel-backend:latest
FRONTEND_IMAGE=dropship-intel-frontend:latest
